# Runtime identity
ENVIRONMENT=production
LOG_LEVEL=INFO
API_PREFIX=/api
CORS_ORIGINS=https://approval.example.internal

# Fixed infrastructure: PostgreSQL and Redis
DATABASE_URL=postgresql+psycopg://approval:replace_me@127.0.0.1:5432/intelligent_approval
REDIS_URL=redis://127.0.0.1:6379/0

# Persistent shared volume. API and every Celery worker must see the same path.
STORAGE_ROOT=/srv/intelligent-approval/reviews
POLICY_RULES_PATH=/srv/intelligent-approval/config/policy_rules.xlsx
ALGORITHM_ROOT=/opt/intelligent-approval/algorithm
MAX_UPLOAD_BYTES=31457280
MAX_DOCUMENTS_PER_REVIEW=10

# Step 1/2/3 orchestration
ALGORITHM_USE_EMBEDDING=true
ALGORITHM_USE_LLM_MATCHING=true
ALGORITHM_STRICT_LLM=true
ALGORITHM_ENABLE_LLM_CHECK=true
ALGORITHM_LLM_REVIEW=false
ALGORITHM_MAX_SECTION_PAGES=8
ALGORITHM_CANDIDATE_COUNT=8
ALGORITHM_EVIDENCE_COUNT=3
ALGORITHM_MINIMUM_SCORE=0.03
ALGORITHM_MATCH_WORKERS=4
ALGORITHM_CHECK_WORKERS=4
TASK_STALE_AFTER_MINUTES=360

# Existing algorithm/vLLM settings consumed by algorithm/config.py
LOCAL_LLM_BASE_URL=http://127.0.0.1:8001/v1
LOCAL_LLM_MODEL=Qwen3-8B
LOCAL_LLM_API_KEY=EMPTY
LOCAL_LLM_TIMEOUT=180
LOCAL_LLM_MAX_CONNECTIONS=16
LOCAL_EMBED_MODEL=/home/zyl/public/LLM Library/bge-m3
LOCAL_EMBED_DEVICE=cpu
LOCAL_EMBED_BATCH_SIZE=16
SEMANTIC_WORKERS=4
MATCHING_WORKERS=4
