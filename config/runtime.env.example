# IntelligentApproval 唯一运行配置模板。
# 首次部署执行：bash scripts/setup_runtime_config.sh
# 路径含空格时必须像下面的模型路径一样使用双引号。

# ==================== PostgreSQL / Redis ====================
# Docker 测试环境使用下面的 POSTGRES_* 变量创建和暴露数据库。
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=intelligent_approval
POSTGRES_USER=approval
POSTGRES_PASSWORD=approval
# 默认由上面的字段自动拼接；使用企业现有数据库时可直接把这一行改成完整连接地址。
DATABASE_URL="postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL="redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}"

# ==================== FastAPI / 文件存储 ====================
APP_NAME="IntelligentApproval API"
ENVIRONMENT=production
LOG_LEVEL=INFO
API_PREFIX=/api
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_API_WORKERS=2
CORS_ORIGINS=http://127.0.0.1:5173

# APP_PROJECT_ROOT 由启动脚本自动提供，不需要手工填写项目绝对路径。
STORAGE_ROOT="${APP_PROJECT_ROOT}/runtime/reviews"
POLICY_RULES_PATH="${APP_PROJECT_ROOT}/data/招标文件预警规则梳理_V1.0_yy_20260610.xlsx"
ALGORITHM_ROOT="${APP_PROJECT_ROOT}/algorithm"
MAX_UPLOAD_BYTES=31457280
MAX_DOCUMENTS_PER_REVIEW=10
UPLOAD_CHUNK_BYTES=1048576

# ==================== Celery ====================
CELERY_WORKER_CONCURRENCY=1
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_BEAT_SCHEDULE="${APP_PROJECT_ROOT}/runtime/celerybeat-schedule"
TASK_STALE_AFTER_MINUTES=360
CELERY_REQUEUE_INTERVAL_SECONDS=60
CELERY_STALE_RECOVERY_INTERVAL_SECONDS=300

# 首次全链路测试脚本的轮询设置，不影响正式任务执行。
SMOKE_REVIEW_TIMEOUT=7200
SMOKE_REVIEW_POLL_INTERVAL=5

# ==================== 后端调用算法的开关 ====================
ALGORITHM_USE_EMBEDDING=true
ALGORITHM_USE_LLM_MATCHING=true
ALGORITHM_STRICT_LLM=true
ALGORITHM_ENABLE_LLM_CHECK=true
ALGORITHM_LLM_REVIEW=false
ALGORITHM_MAX_SECTION_PAGES=8
ALGORITHM_CANDIDATE_COUNT=8
ALGORITHM_EVIDENCE_COUNT=3
ALGORITHM_MINIMUM_SCORE=0.03
ALGORITHM_CONTINUE_ON_ERROR=true

# 仅供 scripts/algorithm 下的独立算法测试脚本使用；Web 后端上传不读取这两个路径。
ALGORITHM_ONE_REPORT_PATH="${APP_PROJECT_ROOT}/data/reports/招标文件1.pdf"
ALGORITHM_REPORTS_PATH="${APP_PROJECT_ROOT}/data/reports"

# ==================== Qwen3-8B vLLM 服务 ====================
LLM_CUDA_VISIBLE_DEVICES=3
LLM_MODEL_PATH="/home/zyl/public/LLM Library/Qwen3-8B"
LLM_MODEL=Qwen3-8B
LLM_HOST=127.0.0.1
LLM_PORT=8001
LLM_MAX_MODEL_LEN=16384
LLM_GPU_MEM_UTIL=0.9
LLM_MAX_NUM_SEQS=16

# ==================== 算法中的 Qwen 客户端 ====================
# 默认直接连接上面配置的 vLLM；如 vLLM 在另一台机器，直接修改此 URL。
LOCAL_LLM_BASE_URL="http://${LLM_HOST}:${LLM_PORT}/v1"
LOCAL_LLM_MODEL="${LLM_MODEL}"
LOCAL_LLM_MODEL_PATH="${LLM_MODEL_PATH}"
LOCAL_LLM_API_KEY=EMPTY
LOCAL_LLM_CANDIDATE_CHARS=1200
LOCAL_LLM_TIMEOUT=180
LOCAL_LLM_MAX_CONNECTIONS=16
MATCHING_WORKERS=4
SEMANTIC_WORKERS=4
SEMANTIC_MAX_TOKENS=768
SEMANTIC_MAX_RETRIES=1
SEMANTIC_MAX_EVIDENCE_CHARS=16000
SEMANTIC_MAX_CHARS_PER_EVIDENCE=8000
REVIEW_MAX_EVIDENCE_CHARS=20000

# ==================== BGE-M3 embedding ====================
LOCAL_EMBED_MODEL="/home/zyl/public/LLM Library/bge-m3"
LOCAL_EMBED_DEVICE=cpu
LOCAL_EMBED_BATCH_SIZE=16
LOCAL_EMBED_WEIGHT=0.45
LOCAL_EMBED_CHUNK_CHARS=1400
LOCAL_EMBED_CHUNK_OVERLAP=200
LOCAL_EMBED_STRICT=false

# ==================== 前端 ====================
# 默认走 Vite 反向代理（vite.config.ts 把 /api 转发到本机后端），浏览器同源免 CORS。
# 如需前端直连后端，改为 http://服务器IP:8000/api，并在 CORS_ORIGINS 放行前端源。
VITE_REVIEW_API_URL=/api
